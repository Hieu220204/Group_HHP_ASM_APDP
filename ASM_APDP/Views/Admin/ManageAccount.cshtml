@{
    ViewData["Title"] = "Manage Account";
}

<h2>Manage Accounts</h2>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success">
        @ViewBag.SuccessMessage
    </div>
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

<!-- Student List Table -->
<h3>Student Accounts</h3>
<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Password</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in ViewBag.Students)
        {
            <tr>
                <td>@student.Email</td>
                <td>@student.Password</td>
                <td>@student.Status</td>
                <td>
                    <button class="btn btn-danger" data-toggle="modal" data-target="#deleteModalStudent" data-email="@student.Email">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Teacher List Table -->
<h3>Teacher Accounts</h3>
<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Password</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var teacher in ViewBag.Teachers)
        {
            <tr>
                <td>@teacher.Email</td>
                <td>@teacher.Password</td>
                <td>@teacher.Status</td>
                <td>
                    <button class="btn btn-danger" data-toggle="modal" data-target="#deleteModalTeacher" data-email="@teacher.Email">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal for Delete Confirmation (Student) -->
<div class="modal fade" id="deleteModalStudent" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Delete Student Account</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this student account?
            </div>
            <div class="modal-footer">
                <form method="post" action="@Url.Action("DeleteStudent", "Admin")">
                    <input type="hidden" id="emailStudent" name="email" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Delete Confirmation (Teacher) -->
<div class="modal fade" id="deleteModalTeacher" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Delete Teacher Account</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this teacher account?
            </div>
            <div class="modal-footer">
                <form method="post" action="@Url.Action("DeleteTeacher", "Admin")">
                    <input type="hidden" id="emailTeacher" name="email" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Set email for student delete modal
    $('#deleteModalStudent').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget);
        var email = button.data('email');
        $('#emailStudent').val(email);
    });

    // Set email for teacher delete modal
    $('#deleteModalTeacher').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget);
        var email = button.data('email');
        $('#emailTeacher').val(email);
    });
</script>
