@model List<Schedule>

@{
    ViewData["Title"] = "Manage Schedule";
}

<h2>Manage Schedule</h2>

<table border="1">
    <tr>
        <th>Date</th>
        <th>Time</th>
        <th>Subject</th>
        <th>Room</th>
        <th>Actions</th>
    </tr>
    @foreach (var schedule in Model)
    {
        <tr>
            <form method="post" asp-action="SaveSchedule">
                <input type="hidden" name="Id" value="@schedule.Id" />

            <td><input type="date" name="Date" value="@schedule.Date.ToString("yyyy-MM-dd")" required /></td>
            <td><input type="text" name="Time" value="@schedule.Time" required /></td>
            <td><input type="text" name="Subject" value="@schedule.Subject" required /></td>
            <td><input type="text" name="Room" value="@schedule.Room" required /></td>
            <td>
                <button type="submit">Save</button>
            </td>
            </form>
            <td>
                <form method="post" asp-action="DeleteSchedule">
                    <input type="hidden" name="id" value="@schedule.Id" />
                    <button type="submit" onclick="return confirm('Are you sure?');">Delete</button>
                </form>
            </td>
        </tr>
    }
</table>

<h3>Add New Schedule</h3>
<form method="post" asp-action="SaveSchedule">
    <input type="hidden" name="Id" value="0" />
    <label>Date:</label>
    <input type="date" name="Date" required />

    <label>Time:</label>
    <input type="text" name="Time" required />

    <label>Subject:</label>
    <input type="text" name="Subject" required />

    <label>Room:</label>
    <input type="text" name="Room" required />

    <button type="submit">Add</button>
</form>
