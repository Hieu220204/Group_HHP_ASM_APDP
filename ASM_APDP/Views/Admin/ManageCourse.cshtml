@model List<ASM_APDP.Models.Course>

@{
    Layout = "_Layout";
    var selectedCourse = ViewBag.SelectedCourse as ASM_APDP.Models.Course;
}

<h2>Manage Courses</h2>

<!-- Form thêm hoặc chỉnh sửa khóa học -->
<form method="post" action="@Url.Action(selectedCourse != null ? "EditCourse" : "AddCourse", "Admin")">
    @if (selectedCourse != null)
    {
        <input type="hidden" name="Id" value="@selectedCourse.Id" />
    }

    <label>Course Name:</label>
    <input type="text" name="Name" value="@selectedCourse?.Name" required />

    <label>Description:</label>
    <input type="text" name="Description" value="@selectedCourse?.Description" required />

    <label>Teacher Name:</label>
    <input type="text" name="TeacherName" value="@selectedCourse?.TeacherName" required />

    <label>Duration:</label>
    <input type="text" name="Duration" value="@selectedCourse?.Duration" required />

    <label>Status:</label>
    <input type="text" name="Status" value="@selectedCourse?.Status" required />

    <button type="submit">@(selectedCourse != null ? "Update Course" : "Add Course")</button>
</form>

<hr />

<h3>Course List</h3>
<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>Course Name</th>
            <th>Description</th>
            <th>Teacher</th>
            <th>Duration</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Name</td>
                <td>@course.Description</td>
                <td>@course.TeacherName</td>
                <td>@course.Duration</td>
                <td>@course.Status</td>
                <td>
                    <a href="@Url.Action("EditCourse", "Admin", new { id = course.Id })">Edit</a> |
                    <form method="post" action="@Url.Action("DeleteCourse", "Admin", new { id = course.Id })" style="display:inline;">
                        <button type="submit" onclick="return confirm('Delete this course?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<!-- Nút trở về trang AdminHome -->
<p>
    <a href="@Url.Action("AdminHome", "Admin")">
        <button type="button">← Back to Admin Home</button>
    </a>
</p>