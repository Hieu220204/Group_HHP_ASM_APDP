@model List<ASM_APDP.Models.Course>

@{
    Layout = "_Layout";
    var selectedCourse = ViewBag.SelectedCourse as ASM_APDP.Models.Course;
}

<style>
    .page-title {
        text-align: center;
        margin-top: 30px;
        color: #333;
        font-size: 28px;
        font-weight: bold;
    }

    .form-card {
        max-width: 800px;
        margin: 30px auto;
        padding: 25px;
        background-color: #f9f9f9;
        border-radius: 12px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.1);
    }

        .form-card label {
            display: block;
            margin-top: 12px;
            font-weight: 600;
            color: #444;
        }

        .form-card input[type="text"] {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

    .btn-submit {
        margin-top: 20px;
        background-color: #28a745;
        color: white;
        padding: 10px 18px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }

        .btn-submit:hover {
            background-color: #218838;
        }

    .table-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
    }

    .styled-table {
        width: 100%;
        border-collapse: collapse;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

        .styled-table th,
        .styled-table td {
            padding: 12px 15px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }

        .styled-table th {
            background-color: #f1f1f1;
            color: #333;
        }

        .styled-table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

    .btn-edit,
    .btn-delete {
        padding: 6px 12px;
        margin: 0 4px;
        border: none;
        border-radius: 4px;
        font-size: 14px;
        cursor: pointer;
        font-weight: 500;
    }

    .btn-edit {
        background-color: #007bff;
        color: white;
        text-decoration: none;
    }

        .btn-edit:hover {
            background-color: #0056b3;
        }

    .btn-delete {
        background-color: #dc3545;
        color: white;
    }

        .btn-delete:hover {
            background-color: #bd2130;
        }

    .btn-back {
        display: inline-block;
        margin: 30px auto;
        padding: 10px 20px;
        background-color: #6c757d;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
    }

        .btn-back:hover {
            background-color: #5a6268;
        }

    .badge-active {
        background-color: #28a745;
        color: white;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
    }

    .badge-inactive {
        background-color: #dc3545;
        color: white;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
    }
</style>

<h2 class="page-title">Manage Courses</h2>

<div class="form-card">
    <form method="post" action="@Url.Action(selectedCourse != null ? "Edit" : "Add", "Course")">
        @if (selectedCourse != null)
        {
            <input type="hidden" name="id" value="@selectedCourse.Id" />
        }

        <label>Course Name:</label>
        <input type="text" name="Name" value="@selectedCourse?.Name" required />

        <label>Description:</label>
        <input type="text" name="Description" value="@selectedCourse?.Description" required />

        <label>Teacher Name:</label>
        <input type="text" name="TeacherName" value="@selectedCourse?.TeacherName" required />

        <label>Duration:</label>
        <input type="text" name="Duration" value="@selectedCourse?.Duration" required />

        <label>Status:</label>
        <input type="text" name="Status" value="@selectedCourse?.Status" required />

        <button type="submit" class="btn-submit">@(selectedCourse != null ? "Update Course" : "Add Course")</button>
    </form>
</div>

<hr />

<h3 style="text-align:center;">Course List</h3>
<div class="table-container">
    <table class="styled-table">
        <thead>
            <tr>
                <th>Course Name</th>
                <th>Description</th>
                <th>Teacher</th>
                <th>Duration</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.Name</td>
                    <td>@course.Description</td>
                    <td>@course.TeacherName</td>
                    <td>@course.Duration</td>
                    <td>
                        <span class="@(course.Status == "Active" ? "badge-active" : "badge-inactive")">
                            @course.Status
                        </span>
                    </td>
                    <td>
                        <a href="@Url.Action("Edit", "Course", new { id = course.Id })" class="btn-edit">Edit</a>
                        <form method="post" action="@Url.Action("Delete", "Course", new { id = course.Id })" style="display:inline;">
                            <button type="submit" class="btn-delete" onclick="return confirm('Delete this course?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p style="text-align:center;">
    <a href="@Url.Action("AdminHome", "Admin")" class="btn-back">← Back to Admin Home</a>
</p>
