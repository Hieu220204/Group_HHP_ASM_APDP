@{
    ViewData["Title"] = "Teacher Home";
}

<style>
    .teacher-dashboard {
        max-width: 800px;
        margin: 40px auto;
        padding: 30px;
        background: #f8f9fa;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0,0,0,0.1);
        text-align: center;
    }

        .teacher-dashboard h2 {
            color: #343a40;
            margin-bottom: 20px;
        }

        .teacher-dashboard p {
            font-size: 1.1rem;
            color: #555;
            margin-bottom: 30px;
        }

    .dashboard-buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

        .dashboard-buttons a {
            display: inline-block;
            padding: 12px 20px;
            background-color: #007bff;
            color: white;
            text-decoration: none;
            font-weight: bold;
            border-radius: 6px;
            transition: background-color 0.3s ease;
        }

            .dashboard-buttons a:hover {
                background-color: #0056b3;
            }

    .logout-link {
        display: block;
        margin-top: 30px;
        color: #dc3545;
        font-weight: bold;
        text-decoration: none;
    }

        .logout-link:hover {
            text-decoration: underline;
        }
</style>

<div class="teacher-dashboard">
    <h2>Welcome to Teacher Home</h2>
   

    <div class="dashboard-buttons">
        <a href="@Url.Action("ChangePasswordTeacher", "ChangePassword")">Change Password</a>
        <a href="@Url.Action("ManageGrade", "Grade")">Manage Grade</a>
        <a href="@Url.Action("ViewClassSchedule", "Schedule")">View Class Schedule</a>
    </div>

    <a href="@Url.Action("Logout", "Teacher")" class="logout-link">Logout</a>
</div>
