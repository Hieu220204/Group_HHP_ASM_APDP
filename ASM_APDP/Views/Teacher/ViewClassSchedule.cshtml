@model List<ASM_APDP.Models.Schedule>

@{
    ViewData["Title"] = "Class Schedule";
}

<h2>Class Schedule</h2>

@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Class Name</th>
                <th>Course Name</th>  <!-- Changed Subject to Course Name -->
                <th>Teacher</th>      <!-- Added Teacher column -->
                <th>Date</th>         <!-- Changed Day to Date -->
                <th>Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var schedule in Model)
            {
                <tr>
                    <td>@schedule.ClassName</td>
                    <td>@schedule.CourseName</td> <!-- Changed Subject to CourseName -->
                    <td>@schedule.Teacher</td>    <!-- Added Teacher -->
                    <td>@schedule.Date.ToString("yyyy-MM-dd")</td>  <!-- Changed Day to Date -->
                    <td>@schedule.Time</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No schedules available for your classes.</p>
}
